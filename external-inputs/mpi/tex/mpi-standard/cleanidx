idxout  = open(idxoutname, "w")

for line in idxfile:
    # Match \indexentry{[NAME:]text}{page}
    # or match \tohtmlindexentry{[NAME:]text}{file}{nodenumber}{section name}
    # where text make have ! (subindex) and |(formatting) as in
    # TERM:get!in function name|hyperindexformat{\uu}
    entryObj = re.match(r'\\tohtmlindexentry{([^:]*:?.*)}({.+}{[0-9]+}{.*})', line, 0)
    if entryObj:
        entryKind = "tohtmlindexentry"
        entryText = entryObj.group(1)
        entryOther = entryObj.group(2)
    else:
        entryObj = re.match(r'\\indexentry\{([^:]*:?.*)}({[0-9]+})', line, 0)
        if entryObj:
            entryKind  = "indexentry"
            entryText  = entryObj.group(1)
            entryOther = entryObj.group(2)
        else:
            printWarningNNL("Did not match entry " + line)

    # Look for kind and strip that off
    entryObj = re.match(r'([^:]*):(.*)', entryText, 0)
    entryIdxname = ""
    if entryObj:
        entryIdxname = entryObj.group(1)
        entryText    = entryObj.group(2)

    # Clean up entry Text
