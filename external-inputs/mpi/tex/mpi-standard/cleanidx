## Check for problems
def checkForPrimary( lst, lstnamestr, doWarn ):
    "Check the list for primary entries"
    namedefs = dict()
    nameprimary = dict()
    titleWritten = 0
    for i in range(len(lst)):
        # Extract the name and the page type
        # Name is <name>|hyperpage}{page#  OR
        #         <name>|hyperindexformat{\uu}}{page#
        idxObj = re.match(r'([^|]*)\|([^}]*)}.*{([0-9]*)$', lst[i], 0)
        if idxObj :
            name = idxObj.group(1)
            if verbose:
                print( "  (cPrimary)Name = " + name)
            if idxObj.group(2) == "hyperpage" :
                if verbose:
                    print( "      use entry")
                if name in namedefs :
                    if namedefs[name] != "defined" :
                        # Must compare locations as integers
                        if int(namedefs[name]) > int(idxObj.group(3)) :
                            namedefs[name] = idxObj.group(3)
                else:
                    namedefs[name] = idxObj.group(3)
            elif idxObj.group(2) == "hyperindexformat{\\uu" or idxObj.group(2) == "hyperindexformat{\\bold":
                if verbose:
                    print( "      defining entry: " + idxObj.group(2) )
                namedefs[name] = 'defined'
                nameprimary[name] = "," + idxObj.group(3) + ","
            else :
                printWarning( "unrecognized format in list " + lstnamestr + ": " + idxObj.group(2) + " on page " + idxObj.group(3))

    if doWarn :
        for name in sorted(namedefs):
            if namedefs[name] != 'defined' :
                if not titleWritten :
                    if printNoPrimary:
                        print( "List " + lstnamestr)
                    if logNoPrimary:
                        noprimefile.write( "List " + lstnamestr + "\n")
                    titleWritten = 1
                # Use sort name
                namebase = re.match(r'([^|@]*)@', name, 0)
                if namebase :
                    itemname = namebase.group(1)
                else:
                    itemname = name
                if printNoPrimary:
                    printWarning(itemname + " does not have a primary index, first used on page " + namedefs[name])
                if logNoPrimary:
                    printToNoPrimary(itemname, namedefs[name])

    # Now that we know which names have a primary entry, we can remove
    # non-primary references on the same page. Move backwards through the
    # list so that the removals don't change the index
    if removeDupSecondaryEntries :
        for i in range(len(lst)-1,0,-1):
            # Extract the name and the page type
            # Name is <name>|hyperpage}{page#  OR
            #         <name>|hyperindexformat{\uu}}{page#
            idxObj = re.match(r'([^|]*)\|([^}]*)}.*{([0-9]*)$', lst[i], 0)
            if idxObj :
                name = idxObj.group(1)
                if verbose:
                    print( "  (removeDup)Name = " + name)
                if idxObj.group(2) == "hyperpage" and namedefs[name] == 'defined' and re.match( ","+idxObj.group(3)+",",nameprimary[name],0) :
                    if verbose :
                        print("Need to remove " + name + " in " + lst[i])
                    del lst[i]

    return

def checkForCase( lst, lstnamestr, exceptionStr, allowsuffix ):
    "Check the list for lower case, ignoring those in the exceptions, and those ending with allowsuffix"
    namedefs = dict()
    titleWritten = 0
    for i in range(len(lst)):
        # Extract the name and the page type
        # Name is <name>|hyperpage}{page#  OR
        #         <name>|hyperindexformat{\uu}}{page#
        idxObj = re.match(r'([^|]*)\|[^}]*}.*{([0-9]*)$', lst[i], 0)
        if idxObj :
            page = idxObj.group(2)
            name = idxObj.group(1)
            # If Name includes a second level, ignore that and extract only
            # the top-level name
            idxObj = re.match(r'([^!]*)!.*', name, 0)
            if idxObj :
                name = idxObj.group(1)
            if verbose:
                print( "  (checkCase)Name = " + name)
            if re.search(r'[a-z]+', name, 0) and not re.search(name, exceptionStr, 0) and not re.search(allowsuffix+'$', name, 0) :
                printWarning("Lowercase " + name + " in " + lstnamestr + " on page " + page)
    return

# Check for characters that should not be used in the text of an index entry
# allow is a string of extra characters to allow in str; may be empty
def checkForBadChars( str, eText, eType, ePage, allow ):
    nameObj = re.match('([^|]*)|', str + '|', 0)
    if nameObj :
        if verbose :
            print( "Name is " + nameObj.group(1) )
        # Look for problems. The name should contain only alphanum and
        # ! and \_
        # Handle the special case of sortkey@formatted line - strip
        # the @... from the clean name
        nameclean = nameObj.group(1).replace('\\_', '_')
        nameclean = re.sub('@.*','', nameclean)
        if allow != '':
            nameclean = re.sub("["+allow+"]", '', nameclean)
        # Special case for {RMA} and {MPI}, to suppress getlatex
        # warnings (yes, a hack)
        nameclean = re.sub('{RMA}', 'RMA', nameclean)
        nameclean = re.sub('{MPI}', 'MPI', nameclean)
        # Do NOT include a comma - this usually means that a subitem
        # was intended
        if re.search('[^a-zA-Z0-9_!:/\(\)\. *-]',nameclean) :
            # First, check for the exceptions
            if nameclean not in knownOK :
                printWarning( "Name contains invalid characters:" + nameclean + " on page " + ePage + " entry type " + eType)
                printWarning( "Full entry is: " + eText )

