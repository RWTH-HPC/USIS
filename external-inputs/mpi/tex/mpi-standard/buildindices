# Redirect makeindex error output (which includes a lot of non-error output!)
mklog = open('mkindex.log', 'w')

def writeIndexData( lst, fname ):
    "Output the index data entries"
    outInd = open( fname, "w" )
    for i in range(len(lst)):
        outInd.write(r"\indexentry{"+lst[i]+"}\n")
    outInd.close()
    return

def createIndex( infile, outfile ):
    # Run the process to create the index file.
    subprocess.run(["makeindex", "-c", "-o", outfile, infile], stderr=mklog)
    return

def appendFile( ofile, fname ):
    " Append the file name to the open file ofile"
    ifile = open( fname, "r" )
    for line in ifile:
        # Special case: change the environment for each index
        if re.match(r'\\begin\{theindex\}', line):
            line = "\\begin{myindex}\n"
        elif re.match(r'\\end\{theindex\}', line):
            line = "\\end{myindex}\n"

        ofile.write(line)
    ifile.close()
    return

def writeHeader( ofile, idxname, shortname, header ):
    " Format the header and append to ofile"
    ofile.write("%%%% THIS FILE CREATED BY buildindices on %s.  DO NOT EDIT\n" % datetime.datetime.now())
    ofile.write("\\newpage\n\\phantomsection\n\\addcontentsline{toc}{chapter}")
    ofile.write("{%s}\n" % idxname )
    # For scrbook, we must manually set the running headers
    ofile.write("\\markboth{%s}{%s}\n" % (idxname, idxname) )
    ofile.write("\\label{index:%s}\n" % shortname )
    ofile.write("\\makeatletter\n\\renewcommand{\\@index}{%s}\n" % idxname )
    ofile.write("\\renewcommand{\\@introtext}{%s}\n\\makeatother\n" % header )
    return

def funcidxUpcaseOrder( lst ):
    " Use upper-case only to sort function names, and use standard formatting for functions"
    listtmp = []
    for i in range(len(lst)):
        # Extract the name for sorting
        item = re.match(r'([^|@!]*)([\|!].*)$', lst[i], 0)
        if item :
            name = item.group(1)
            rem  = item.group(2)
            name = name.upper() + "@\\IImpifuncfmt{" + name + "}"
            listtmp.append(name + rem)
        else :
            listtmp.append(lst[i]);
    return listtmp

# Write the list out, using replcmd for the command for the name, and
# add eol text to the end of the line
def writeConstList( lst, replcmd, eoltext, ofile ):
    lastname = "ZZZ"
    for name in sorted(lst, key=str.casefold) :
        # Extract just the name
        snameObj = re.match(r'([^@]*)@([^\|]*)\|',name,0)
        if snameObj :
            sname = snameObj.group(1)
            if sname != lastname :
                ofile.write(replcmd + "{" + snameObj.group(1) + "}" + eoltext + "\n")
        lastname = sname

