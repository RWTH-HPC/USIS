## Output of problems
warningfile = sys.stderr
def printWarning( str ):
    global warncount, warningfile
    if warnings :
         warncount += 1
         print( "WARNING:" + str, file=warningfile )
def printWarningNNL( str ):
    global warncount, warningfile
    if warnings :
         warncount += 1
         print( "WARNING:" + str, file=warningfile, end='' )


## Check for problems
def checkForPrimary( lst, lstnamestr, doWarn ):
    """
    Check the list for primary entries
    Also remove non-primary entries on the same page as a primary entry
    """
    # namedefs - defined for a primary definition, else the first page number
    # on which the name appears. Only tof the top level name - e.g., in
    # a!b!c, defined for a, not a!b!c
    # namefulldefs - defined for a primary definition. E.g., if index entry
    # is a!b!c, defined for a!b!c
    # nameprimary - comma separated list of where the top-level name appears
    namedefs = dict()
    namefulldefs = dict()
    nameprimary = dict()
    namefullprimary = dict()

    titleWritten = 0
    for i in range(len(lst)):
        # Extract the name and the page type
        # Name is <name>|hyperpage}{page#  OR
        #         <name>|hyperindexformat{\uu}}{page# OR
        #         <name>|hyperxindexformat{\uu}}{page#
        # hyperxindexformat is an update from the hyperref package to
        # (some?) uses of hyperindexformat. This supports both.
        idxObj = re.match(r'([^|]*)\|([^}]*)}.*{([0-9]*)$', lst[i], 0)
        if idxObj :
            namefull = idxObj.group(1)
            # For deteching entries with no primary, we just look at the top
            # level name.
            nmObj = re.match(r'([^!]*)!.*', namefull, 0)
            if nmObj :
                name = nmObj.group(1)
            else :
                name = namefull
            if verbose :
                print( "  (cPrimary)Name = " + name + "[" + lst[i] + "]")
            if idxObj.group(2) == "hyperpage" :
                if verbose:
                    print( "      use entry")
                if name in namedefs :
                    if namedefs[name] != "defined" :
                        # Must compare locations as integers
                        if int(namedefs[name]) > int(idxObj.group(3)) :
                            namedefs[name] = idxObj.group(3)
                else:
                    namedefs[name] = idxObj.group(3)
                if namefull in namefulldefs :
                    if namefulldefs[namefull] != "defined" :
                        # Must compare locations as integers
                        if int(namefulldefs[namefull]) > int(idxObj.group(3)) :
                            namefulldefs[namefull] = idxObj.group(3)
                else:
                    namefulldefs[namefull] = idxObj.group(3)
            elif idxObj.group(2) == "hyperx?indexformat{\\uu" or idxObj.group(2) == "hyperx?indexformat{\\bold" or re.match(r'hyperx?indexformat{\\see{.*',idxObj.group(2),0) or re.match(r'hyperx?indexformat{\\seealso{.*',idxObj.group(2),0) :
                if verbose:
                    print( "      defining entry: " + idxObj.group(2) )
                if  warnDupPrimary and namefull in namefulldefs and namefulldefs[namefull] == 'defined' :
                    # duplicate primary definitions
                    printWarning("Duplicate primary definition for " + namefull + " on page " + idxObj.group(3) + " others at " + nameprimary[namefull])
                namedefs[name] = 'defined'
                namefulldefs[name] = 'defined'
                if name in nameprimary :
                    nameprimary[name] = nameprimary[name] + "," + idxObj.group(3)
                else :
                    nameprimary[name] = idxObj.group(3)
                if namefull in namefullprimary :
                    namefullprimary[namefull] = namefullprimary[namefull] + "," + idxObj.group(3)
                else :
                    namefullprimary[namefull] = idxObj.group(3)
            else :
                printWarning( "unrecognized format in list " + lstnamestr + ": " + idxObj.group(2) + " on page " + idxObj.group(3))
                printWarning( "Full entry is: " + lst[i] )

    if doWarn :
        for name in sorted(namedefs):
            if namedefs[name] != 'defined' :
                if not titleWritten :
                    if printNoPrimary:
                        print( "List " + lstnamestr)
                    if logNoPrimary:
                        noprimefile.write( "List " + lstnamestr + "\n")
                    titleWritten = 1
                # Use sort name
                namebase = re.match(r'([^|@]*)@', name, 0)
                if namebase :
                    itemname = namebase.group(1)
                else:
                    itemname = name
                if printNoPrimary:
                    printWarning(itemname + " does not have a primary index, first used on page " + namedefs[name])
                if logNoPrimary:
                    if verbose :
                        print("  adding " + name + " to nomain log")
                    printToNoPrimary(itemname, namedefs[name])

    # Now that we know which names have a primary entry, we can remove
    # non-primary references on the same page. Move backwards through the
    # list so that the removals don't change the index
    if removeDupSecondaryEntries :
        for i in range(len(lst)-1,0,-1):
            # Extract the name and the page type
            # Name is <name>|hyperpage}{page#  OR
            #         <name>|hyperindexformat{\uu}}{page# OR
            #         <name>|hyperxindexformat{\uu}}{page#
            idxObj = re.match(r'([^|]*)\|([^}]*)}.*{([0-9]*)$', lst[i], 0)
            if idxObj :
                name = idxObj.group(1)
                nmObj = re.match(r'([^!]*)!.*', name, 0)
                if nmObj :
                    name = nmObj.group(1)
                if verbose:
                    print( "  (removeDup)Name = " + name)
                if idxObj.group(2) == "hyperpage" and namedefs[name] == 'defined' and re.match( ","+idxObj.group(3)+",",nameprimary[name],0) :
                    if verbose :
                        print("Need to remove " + name + " in " + lst[i])
                    del lst[i]

    return

def checkForCase( lst, lstnamestr, exceptionStr, allowsuffix ):
    "Check the list for lower case, ignoring those in the exceptions, and those ending with allowsuffix"
    namedefs = dict()
    titleWritten = 0
    for i in range(len(lst)):
        # Extract the name and the page type
        # Name is <name>|hyperpage}{page#  OR
        #         <name>|hyperindexformat{\uu}}{page# OR
        #         <name>|hyperxindexformat{\uu}}{page#
        idxObj = re.match(r'([^|]*)\|[^}]*}.*{([0-9]*)$', lst[i], 0)
        if idxObj :
            page = idxObj.group(2)
            name = idxObj.group(1)
            # If Name includes a second level, ignore that and extract only
            # the top-level name
            idxObj = re.match(r'([^!]*)!.*', name, 0)
            if idxObj :
                name = idxObj.group(1)
            if verbose:
                print( "  (checkCase)Name = " + name)
            if re.search(r'[a-z]+', name, 0) and not re.search(name, exceptionStr, 0) and not re.search(allowsuffix+'$', name, 0) :
                printWarning("Lowercase " + name + " in " + lstnamestr + " on page " + page)
    return

# Check for characters that should not be used in the text of an index entry
# allow is a string of extra characters to allow in str; may be empty
# Note that no more than two ! may be used to specify subitems
def checkForBadChars( str, eText, eType, ePage, allow ):
    nameObj = re.match('([^|]*)|', str + '|', 0)
    if nameObj :
        if verbose :
            print( "Name is " + nameObj.group(1) )
        # Look for problems. The name should contain only alphanum and
        # ! and \_
        # Handle the special case of sortkey@formatted line - strip
        # the @... from the clean name
        nameclean = nameObj.group(1).replace('\\_', '_')
        nameclean = re.sub('@.*','', nameclean)
        if allow != '':
            nameclean = re.sub("["+allow+"]", '', nameclean)
        # Special case for {RMA} and {MPI}, to suppress getlatex
        # warnings (yes, a hack)
        nameclean = re.sub('{RMA}', 'RMA', nameclean)
        nameclean = re.sub('{MPI}', 'MPI', nameclean)
        # Do NOT include a comma - this usually means that a subitem
        # was intended
        if re.search(r'[^a-zA-Z0-9_!:/\(\)\. *-]',nameclean) :
            # First, check for the exceptions
            if nameclean not in knownOK :
                printWarning( "Name contains invalid characters:" + nameclean + " on page " + ePage + " entry type " + eType)
                printWarning( "Full entry is: " + eText )
        # Check for too many !
        if re.search('.*!.*!.*!.*', nameclean) :
            printWarning( "Name contains too many subitems: " + nameclean + " on page " + ePage + " entry type " + eType)
            printWarning( "Full entry is: " + eText )

def checkSpecialLists(str):
    # Look for the known prefixes for the special constants.  Str is known
    # to be a CONST
    for prefix in constPrefixes.keys():
        if re.match(prefix,str):
            constPrefixes[prefix].append(str)
            break

