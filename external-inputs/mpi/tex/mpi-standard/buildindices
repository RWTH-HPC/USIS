## Process the index file from the latex run
idxfile = open('mpi-report.idx')
for line in idxfile:
    # Match \indexentry{[NAME:]text}{page}
    # where text may have ! (subindex) and |(formatting) as in
    # TERM:get!in function name|hyperindexformat{\uu}
    # TERM:get!in function name|hyperxindexformat{\uu}
    # FIXME: This will not handle pages in the frontmatter - with numbers
    # in Roman numerals. (e.g., iii or xvi)
    entryObj = re.match(r'\\indexentry\{(.*?):(.*?)}{([0-9]+)}', line, 0)
    if entryObj:
        entryText    = entryObj.group(2)
        entryPage    = entryObj.group(3)
        entryType    = entryObj.group(1)
        entrySubtype = ""
        e2Obj = re.match(r'([^=]*)=(.*)', entryType, 0)
        if e2Obj:
            entryType    = e2Obj.group(1)
            entrySubtype = e2Obj.group(2)
        if verbose:
            print( "Index " + entryType)
            if entrySubtype != "":
                print( "Subtype " + entrySubtype)
            print( "Text " + entryText)
            print( "Page " + entryPage)
    else :
        entryObj = re.match(r'\\indexentry\{(.*?)}{([0-9]+)}', line, 0)
        if entryObj:
            if verbose:
                print( "Index Function")
                print( "Text " + entryObj.group(1))
                print( "Page " + entryObj.group(2))
            entryType    = "MPIFUNCTION"
            entrySubtype = ""
            entryText    = entryObj.group(1)
            entryPage    = entryObj.group(2)
            # FIXME: This is an ugly hack
            if not re.match("MPI",entryText) and not re.match("PMPI",entryText) and not re.match("mpiexec",entryText) and not re.match("mpirun",entryText) and not re.match("COPY\\\\_FUNCTION",entryText) and not re.match("DELETE\\\\_FUNCTION", entryText) and not re.match("COMM\\\\_COPY\\\\_ATTR\\\\_FUNCTION",entryText) and not re.match("COMM\\\\_DELETE\\\\_ATTR\\\\_FUNCTION",entryText):
                if warnBadFunc :
                    printWarning("function index not MPI: " + entryText + " page " + entryPage)
                if ignoreBadFunc:
                    entryType = "Unknown"
            elif not re.match("MPI",entryText) and not re.match("PMPI",entryText) and not re.match("mpiexec",entryText) and not re.match("mpirun",entryText):
                printWarning("function index is exception: " + entryText + " page " + entryPage)
        else:
            entryType = "Unknown"
            entryText = ""

    # replace any newlines with a blank. Handle the case that an index
    # command was mangled.
    try:
        entryText
    except NameError:
        printWarning("mangled index entry, type " + entryType + ", input:" + line)
    else:
        entryText = re.sub('\n', ' ', entryText)

    if entryType == "MPIFUNCTION" or entryType == "TYPEDEF":
        # This is complex, because an index entry may contain LaTeX commands
        # with @ characters. This should remove balanced parenthesis strings
        # This is required because of how the function definitions are
        # handled in the LaTeX source, which include the function parmaeters
        # (and LaTeX commands around them) in the index entry, and these should
        # not be part of the index entry.  This processing should *not* be
        # applied elsewhere; for example, "TYPE(MPI_Status)" is a valid
        # declaration entry to index
        splitObj = re.search(r'(.*)\([^\(\)]*\)(.*)', entryText, re.DOTALL)
        while splitObj:
            if verbose:
                print("Removing a balanced paren from " + entryText)
            entryText = splitObj.group(1) + splitObj.group(2)
            splitObj = re.search(r'(.*)\([^\(\)]*\)(.*)', entryText, re.DOTALL)

    # Error checking
    if entryType != "Unknown" :
        if verbose:
            print("Checking " + entryText)
        if re.match('^ *$',entryText,0) or re.match(r'^ *\|',entryText,0):
            printWarningNNL("Empty index entry" + line)
            entryType = "Unknown"
    # Additional error checking for invalid characters is performed after
    # any type-specific processing is performed, using checkForBadChars

    # Add the entry to the appropriate index list
    # Note that we allow comma in the text for the general (TERM) index
    if   entryType == "TERM" :
        checkForBadChars( entryText, entryText, entryType, entryPage, "," )
        listTERM.append(entryText + "}{" + entryPage)
    elif entryType == "CONST" :
        # Depending on the name, this is either the constants (all uppercase)
        # or declarations (mixed case). Note some constants are all lowercase
        # (info keys and vals). Consider marking declarations in the macro
        # instead of this derived rule.
        mm = re.match(r'TYPE\(([^@]*)\)(@.*)', entryText)
        if mm :
            if verbose :
                print( "Removing TYPE from " + entryText)
            # Remove ", DIMENSION(*...)" if it appears - this is like removing
            # the "*" in an mpictype for an array or pointer
            if re.search(r', *DIMENSION', mm.group(2)) :
                if verbose :
                    print("Found dimension in TYPE:" + entryText)
                m2 = re.match(r'TYPE\(([^\)]*)[^@]*\)(@.*TYPE\([^\)]*\))[^\|}]*(}\|.*)', entryText)
                if m2 :
                    entryText = m2.group(1) + m2.group(2) + m2.group(3)
                    if verbose :
                        print("Replacement is : " + entryText)
                else :
                    printWarning("Failed to extract DIMENSION from TYPE in: " + entryText)
            else :
                entryText = mm.group(1) + mm.group(2)
            if verbose :
                print(" result is " + entryText)
        if re.match(r'MPI[:\\_A-Z0-9a-z]*[a-z]\s*[*]*@', entryText) :
            # Remove "*" at the end if this type was shown in the text
            # to show the use as a pointer to the type.
            # Remove only if it shows up in the key (but remove in both
            # key and formatted name in that case)
            mm = re.match(r'[^@]*[*]+.*@', entryText)
            if mm :
                if verbose :
                    print( "Removing * from " + entryText)
                entryText =re.sub(r' *[*]+', '', entryText)
                #entryText = entryText.replace("*","")
                if verbose :
                    print( "Replacement is " + entryText)
            checkForBadChars( entryText, entryText, entryType, entryPage, "" )
            listDECLS.append(entryText + "}{" + entryPage)
        elif re.match(r'MPI[:\\_A-Z0-9]*[A-Z0-9]@', entryText) :
            checkForBadChars( entryText, entryText, entryType, entryPage, "" )
            listCONST.append(entryText + "}{" + entryPage)
            checkSpecialLists(entryText)
        else :
            if warnBadConst :
                printWarning("Unrecognized constant " + entryText + " page " + entryPage)
            if ignoreBadConst:
                entryType = "Unknown"
    elif entryType == "INFOCONST" :
        # Check for invalid characters (should be alphanum or _)
	# for infovalue, also allow commas
        if entrySubtype == "VAL":
            # FIXME: Allow commas in the entry - skip this test for now
            #if re.match(r'[A-Za-z0-9_\\|,]*@', entryText) :
            #    checkForBadChars( entryText, entryText, entryType, entryPage )
            listCONST.append(entryText + "}{" + entryPage)
            listINFOCONST_VAL.append(entryText)
        elif re.match(r'[A-Za-z0-9_\\|]*@', entryText) :
            checkForBadChars( entryText, entryText, entryType, entryPage, "" )
            listCONST.append(entryText + "}{" + entryPage)
            if entrySubtype == "KEY":
                listINFOCONST_KEY.append(entryText)
            else:
                listINFOCONST.append(entryText)
        else :
            printWarning("Unrecognized info constant " + entryText + " page " + entryPage)
    elif entryType == "DATATYPE" :
        # Check for invalid characters (should be MPI[::|_][A-Z_0-9] only
        # Especially no lower case - those are likely MPI C types.
        if re.match(r'MPI[:\\_A-Z0-9]*[A-Z0-9]@', entryText) :
            checkForBadChars( entryText, entryText, entryType, entryPage, "" )
            listCONST.append(entryText + "}{" + entryPage)
            listDATATYPE.append(entryText)
        else :
            printWarning("Unrecognized MPI Datatype handle constant " + entryText + " page " + entryPage)
    elif entryType == "STRINGCONST" :
        # Check for invalid characters (should be alphanum or _)
        if re.match(r'[A-Za-z0-9:/_\\|]*@', entryText) :
            checkForBadChars( entryText, entryText, entryType, entryPage, "" )
            listCONST.append(entryText + "}{" + entryPage)
            listSTRINGCONST.append(entryText)
        else :
            printWarning("Unrecognized string constant " + entryText + " page " + entryPage)
    elif entryType == "EXAMPLES" :
        checkForBadChars( entryText, entryText, entryType, entryPage, "" )
        listEXAMPLES.append(entryText + "}{" + entryPage)
    elif entryType == "TYPEDEF" :
        checkForBadChars( entryText, entryText, entryType, entryPage, "" )
        listTYPEDEF.append(entryText + "}{" + entryPage)
    elif entryType == "MPIFUNCTION" :
        checkForBadChars( entryText, entryText, entryType, entryPage, "" )
        listFUNCS.append(entryText + "}{" + entryPage)
    elif entryType == "BCFUNCTION" :
        checkForBadChars( entryText, entryText, entryType, entryPage, "" )
        # Make this entry a subitem under the primary function
        # entryText looks like
        # MPI_xxx_c|hyperindexformat{\uu} or
        # MPI_xxx_c|hyperxindexformat{\uu} or
        # MPI_xxx_c|hyperpage
        # Extract function name, update entry text
        parts = re.match(r'([A-Za-z0-9_\\]*)\\_c\|(.*)$', entryText, 0)
        if parts :
            basename = parts.group(1)
            pageformat = parts.group(2)
            entryText = basename.upper() + "!" + basename + "\\_c@\\IImpifuncfmt{" + basename + "\\_c}|" + pageformat
        listFUNCS.append(entryText + "}{" + entryPage)
    elif entryType == "NEWEXAMPLES" :
        # Break the Entry text into values:
        #   (number)::(language)::(short desc)::(routine[,routine...])
	# Note: the number might be -1 to indicate no valid example
	# number. This permits the use of this example indexing, except
	# that entries that use the example number wil be skipped.
	# The short description can also be empty, in which case
	# no index entry is generated for a description (entries are
	# still generated for the objects)
        [exnum,exlang,exdesc,rlist]   = entryText.split("::")
        # if there is a formatting command (e.g., |hyperpage),
        # capture that and remove it from the list of names
        [rstr,hformat] = rlist.split("|")
        # names my have an optional prefix, c,d,t.  This is handled below
        routines = rstr.split(",")
        if hformat != "":
            hformat = "|" + hformat

        # Check on valid language
        # "Neutral" is used for language-independent
        if exlang != "C" and exlang != "Fortran" and exlang != "Neutral" :
            printWarning("Exindex language " + exlang + " is unknown")
        # Replace the name with what will be used in an index entry.
        if exlang == "Neutral" :
            exlang = "Language-independent"

        # Add the examples in 4 different places; we can drop some of these
        # after review (for example, the first of these - adding the function
        # name to the examples when a short description is available)
        checkForBadChars( exdesc, entryText, entryType, entryPage, "\\\\#=`'" )
        if ExamplesAddByNumber :
            # Ignore if number is invalid (NA)
            if exnum != 'NA' and exdesc != '' :
                # Check for the case where exdesc includes @.
                # First, split the exdesc into desctop!descbottom.
                # descsecond may be empty
                sp = re.match(r'([^!]*)!(.*)', exdesc, 0)
                if sp:
                    desctop    = sp.group(1)
                    descbottom = sp.group(2)
                else:
                    desctop    = exdesc
                    descbottom = ''

                sp = re.match(r'(.*)@(.*)', desctop, 0)
                if sp:
                    exdescsort      = sp.group(1)
                    exdescformatted = sp.group(2)
                else:
                    exdescsort      = desctop
                    exdescformatted = desctop
                # Also, To get intended sorting order, for the
                # sort key, ensure that the number is represented
                # in a way that sorts as expected in word order. I.e.,
                # instead of 2.3, use 02.03, so this sorts before 11.12.
                sp = re.match(r'([0-9]*)\.([0-9]*)$', exnum, 0)
                if sp:
                    exnumtop = sp.group(1)
                    exnumbot = sp.group(2)
                    exnumsort      = exnumtop.rjust(2,'0') + "." + exnumbot.rjust(2,'0')
                    exnumformatted = exnum
                else:
                    # Did not recognize format, so use as is
                    exnumsort      = exnum
                    exnumformatted = exnum

                descwithnum = "Example " + exnumsort + ": " + exdescsort + "@" + "Example " + exnumformatted + ": " + exdescformatted
                if descbottom != '':
                    descwithnum = descwithnum + "!" + descbottom
                listEXAMPLES.append(descwithnum + hformat + "}{" + entryPage)

        for f in routines:
            # Skip empty values of f
            if f == '':
                continue
            # Extract the name and name type (c,d,f,i,t):
            item = re.match(r'([^:]*):(.*)', f, 0)
            if item :
                nametype = item.group(1)
                name     = item.group(2)
            else :
                nametype = "f"
                name     = f

            # Ensure name is in correct case - make Fortran names uppercase.
            # Query: Is there any non-routine case where this is not correct?
            if exlang == "Fortran":
                name = name.upper()

            # Format the name
            if nametype == 'f':
                nameformatted = name + "@" + "\\IImpifuncfmt{" + name + "}"
            elif nametype == 't':
                nameformatted = name + "@" + "\\textsf{" + name + "}"
            elif nametype == 'i':
                nameformatted = name + "@" + "\\IIfmatstring {" + name + "}"
            else:
                nameformatted = name + "@" + "\\IIconstfmt {" + name + "}"

            if ExamplesAddWithDesc :
                if exdesc != '':
                    listEXAMPLES.append(nameformatted + "!" + exdesc + hformat + "}{" + entryPage)
            else :
                # Add without the description
                listEXAMPLES.append(nameformatted + hformat + "}{" + entryPage)

            if ExamplesAddByDesc :
                if exdesc != '' :
                    listEXAMPLES.append(exdesc + "!" + nameformatted + hformat + "}{" + entryPage)
            if nametype == "f":
                if ExamplesAddToFuncs :
                    # Special case: FUNCS requires routine names in uppercase
                    listFUNCS.append(name.upper() + "!" + exlang + " example usage" + hformat + "}{" + entryPage)
            elif nametype == "c" or nametype == "i":
                if ExamplesAddToConsts :
                    listCONST.append(nameformatted + "!" + exlang + " example usage" + hformat + "}{" + entryPage)
            elif nametype == "d":
                if ExamplesAddToDecls :
                    listDECLS.append(nameformatted + "!" + exlang + " example usage" + hformat + "}{" + entryPage)
            elif nametype == "t":
                if ExamplesAddToTypedefs :
                    listTYPEDEFS.append(nameformatted + "!" + exlang + " example usage" + hformat + "}{" + entryPage)
            else :
                printWarning("Unrecognized MPI name:" + f)
    else :
        printWarningNNL("Unrecognized entry " + line)

