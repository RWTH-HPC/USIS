def primaryvaltolist( pval ) :
    """
    Convert primaries[text] into a string list of pages. The value is
    a dict whose keys are page numbers
    """
    lstr = ""
    for p in pval :
        if lstr != "" :
            lstr = lstr + ", "
        lstr = lstr + str(p)
    return lstr
# --------------------------------------------------------------------------
# Two pass processing. Used to
# 1. Detect missing or multiple primary definitions
# 2. Remove "normal" entries with the primary occurs on the same page
# Method:
#    First pass:
#       extract name, islinkprimary, page from each entry (from list used
#       for an index page)
#       if isPrimary, add page to primaries
#    Issue warnings for duplicate primaries (at end, so just once with all pages)
#    Second pass:
#       For each element of list, extract name, islinkprimary, page
#       if primary, continue
#       if name not in primaries, add to noprimary list
#       else if page same as definition (handling multiple pages), delete list
#       entry. Note: This must check the *full* entry
#
def extractFromEntry( text ) :
    # This is the entry, without the \indexentry{ and the closing }
    entryObj = re.match(r'(.*)\|(.*)\}\{([0-9]+)', text, 0)
    if entryObj :
        entryFullText = entryObj.group(1)
        entryLinkType = entryObj.group(2)
        entryPage     = entryObj.group(3)
        # Is this a primary entry?
        entryIsPrimary = IsEntryPrimary( entryLinkType )
        entryObj = re.match(r'([^!@]*).*', entryFullText)
        if entryObj :
            topname = entryObj.group(1)
        else :
            topname = entryFullText
        return [ entryFullText, topname, entryIsPrimary, entryPage ]
    else :
        return [ "", "", 0, 0 ]

def checkPrimary( lst, lstname, needsPrimary, warndup ) :
    """
    Check the list for primary entries
    Also remove non-primary entries on the same page as a primary entry
    Only warn about duplicate primaries if warndup and (WarnDupPrimary)
    are both true
    """
    primaries = dict()
    topprimaries = dict()
    # First pass
    for item in lst:
        [ text, topname, isPrimary, page ] = extractFromEntry( item )
        if verbose :
            print("  checkPrimary name = " + topname + "[" + item + "]")
        if isPrimary :
            if verbose :
                print("      primary entry")
            if warndup and warnDupPrimary and text in primaries :
                # duplicate
                printWarning("Duplicate primary definition for " + text + " on page " + page + " others at " + primaryvaltolist(primaries[text]))
            if not text in primaries :
                primaries[text] = dict()
            primaries[text][page] = 1
            topprimaries[topname] = page

    # Second pass
    # We have to manage and test i like this because we may change the
    # length of the list
    nlst = len(lst)
    i = 0
    titleWritten = 0
    while i < nlst :
        [ text, topname, isPrimary, page ] = extractFromEntry( lst[i] )
        if isPrimary :
            i = i + 1
            continue
        if text in primaries :
            for pp in primaries[text] :
                if pp == page :
                    # This entry has a primary on the same page
                    if verbose :
                        print("Deleting duplicate non-primary " + lst[i])
                    del lst[i]
                    nlst = nlst - 1
                    i = i - 1 # To undo the incr below
                    break
        else :
            # Only test the top-level name to ensure primary definition
            if not topname in topprimaries and needsPrimary :
                if not titleWritten :
                    if printNoPrimary:
                        printWarning( "List " + lstname)
                    if logNoPrimary:
                        noprimefile.write( "List " + lstname + "\n")
                    titleWritten = 1
                if printNoPrimary :
                    printWarning(topname + " does not have a primary index, first used on page " + page)
                if logNoPrimary :
                    printToNoPrimary(topname, page)
        i = i + 1

