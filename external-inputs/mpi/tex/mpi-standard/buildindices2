# Take a number of the for n.m and right justify both n and m to nd digits.
# E.g., 3.1 -> 03.01 and 11.2 -> 11.02
def normalizeNumber( text, nd ) :
    m = re.match(r'([0-9]*)\.([0-9]*)$', text)
    if m :
        text = m.group(1).rjust(nd,'0') + "." + m.group(2).rjust(nd,'0')
    return text

def processExample(text, linktype, page):
    #   number::languages::desc::handlelist
    [exnum,llist,exdesc,rlist]   = text.split("::")
    objects = rlist.split(",")
    langs   = llist.split(",")

    checkValidIndexEntry( exdesc, page )
    # Ignore entries with no description or number
    if exdesc == "" or exnum == "NA":
        return

    # Example entry with no routine information
    # Handle the case of subitems
    m = re.match(r'([^!]*)(!.*)', exdesc, 0)
    if m :
        exdesctop = m.group(1)
        exdescbot = m.group(2)
    else :
        exdesctop = exdesc
        exdescbot = ""

    # Must handle the special case of description with formatting
    m = re.match(r'([^@]*)@(.*)', exdesctop, 0)
    if m :
        exdescsort = m.group(1)
        exdescfmt  = m.group(2)
    else :
        exdescsort = exdesctop
        exdescfmt  = exdesctop
    # AddByNumber
    if ExamplesToAdd['NUMBER'] :
        idxlists["EXAMPLES"].append("Example " + normalizeNumber(exnum,2) + ": " + exdescsort + "@Example " + exnum + ": " + exdescfmt + exdescbot + "|" + linktype + "}{" + entryPage)

    # For each langauge (usually only one)
    for exlang in langs:
        if exlang == "Neutral" :
            exlang = "Language-independent"

        # Note when there are several languages, this may add
        # more than one index entry for a page. The makeindex program
        # will remove duplicates
        for obj in objects :
            # Skip empty values (typically, empty list)
            if obj == "" :
                continue
            # Extract name and type
            robj = re.match(r'([^:]*):(.*)', obj, 0)
            if robj :
                nametype = robj.group(1)
                name     = robj.group(2)
            else :
                nametype = "f"
                name     = obj

            # if language if Fortran, upper case name
            if exlang == "Fortran":
                name = name.upper()

            # format the name
            nameformatted = name + "@" + ExToFmat[nametype] + name + "}"

            # Add to examples list (several different ways)
            # AddWithDesc
            if ExamplesToAdd['WITHDESC'] :
                idxlists["EXAMPLES"].append(nameformatted + "!" + exdesc + "|" + linktype + "}{" + entryPage)
            # AddByDesc
            if ExamplesToAdd['BYDESC'] :
                idxlists["EXAMPLES"].append(exdesc + "!" + nameformatted + "|" + linktype + "}{" + entryPage)

            # For the function index, names are all uppercase, regardless of
            # language
            if nametype == "f" :
                name = name.upper()
                nameformatted = name + "@" + ExToFmat[nametype] + name + "}"

            # Add to the appropriate list
            # AddTo(FUNCS, DECLS, CONST, TYPEDEF)
            if ExamplesToAdd[ExToList[nametype]] :
                idxlists[ExToList[nametype]].append(nameformatted + "!" + exlang + " example usage|" + linktype + "}{" + entryPage)


# Handle some special cases in const, including separating out declarations,
# defined as mixed case names, and to clean up TYPE names.
# Return [ idxname, entrytext ], where idxname might be DECL or CONST
def processConst(text):
    idx = "CONST"   # default case
    # remove , DIMENSION(...). Assumes as @format specifier
    mObj = re.match(r'(TYPE.*), *DIMENSION\(.*\)(@.*TYPE.*), *DIMENSION\(.*\)(.*)', text, 0)
    if mObj :
        if verbose :
            print("Removing DIMENSION from TYPE in " + text)
        text = mObj.group(1) + mObj.group(2) + mObj.group(3)
        idx = "DECL"
    # remove * at end of type
    mObj = re.match(r'(.*)\*(@.*)\*(.*)', text, 0)
    if mObj :
        if verbose :
            print("Removing * from type in " + text)
        text = mObj.group(1) + mObj.group(2) + mObj.group(3)
    # Identify decls as mixed case (must end in lower case)
    mObj = re.match(r'^MPI[\\_:A-Za-z0-9]*[a-z]+@.*', text, 0)
    if mObj :
        idx = "DECL"
    # Also identify decls as TYPE(...), and sort by the object name
    mObj = re.match(r'TYPE *\(([^\)]*)\)(@.*)', text, 0)
    if mObj :
        idx = "DECL"
        text = mObj.group(1) + mObj.group(2)

    # If requested, see if the name belongs to a subclass of const
    foundlist = 0
    if createConstListFiles :
        m = re.match(r'([^@]*).*', text)
        if m :
            name = m.group(1)
        else :
            name = text
        for lname in constlistnames :
            prefix = constlistnames[lname]["prefix"]
            if prefix != "":
                if re.match(prefix,name):
                    constLists[lname].append(name)
                    foundlist = 1

    return [ idx, text, foundlist ]

# Function names need to be formatted (not done by default)
# Also, names should be sorted in upcase, but displayed as written
# The only mixed case names should be the _c names
def processFunction( text ) :
    mObj = re.match('([^@]*)(@.*)', text, 0)
    if mObj :
        name = text.group(1)
        namefmt = text.group(2)
    else :
        name = text
        namefmt = "@\\IImpifuncfmt{" + text +"}"
    # Check for invalid characters in function name
    if re.search(r'[a-z]+', name, 0) :
        printWarning("Lowercase " + name + " in Function list")
    return name + namefmt

def processBCFunction( text ) :
    # Extract the base name and synthesize the new entry
    mObj = re.match(r'(.*)\\_c', text, 0)
    if mObj :
        text = mObj.group(1).upper() + r"@\IImpifuncfmt{" + mObj.group(1).upper() + "}!" + mObj.group(1) + r"\_c@\IImpifuncfmt{" + mObj.group(1) + r"\_c}"
    return text

# --------------------------------------------------------------------------
# Defaults
idxfname = 'mpi-report.idx'

verbose = 0        # General verbose output
# Control of warnings
warnings = 1       # Output warning information
warncount = 0      # Count warnings
warnFails = 0      # If true, any warning is viewed as fatal
warnDupPrimary = 0 # Warn about duplicate primary definitions
logNoPrimary = 0   # Set to 1 to write messages about no primary to a log file
printNoPrimary  = 1 # Print when an entry has no primary definition
ignoreNoPrimary = 1 # If true, do *not* warn about no primary definition.
                    # use --nomain to warn about those

cleanupFiles = 1
# Set true to create files with the info values and the string values
# (Currently under development; can be compared with the values in
# applang-const)
createConstListFiles = 0
printNotInConstlist = 0    # Set to 1 to see all const items not assigned to
                           # a const list

# Set to true to remove index entries on the same page as a primary index
# entry
removeDupSecondaryEntries = 1

# Process input
## Process arguments
parser = argparse.ArgumentParser()
parser.add_argument('--nomain', help="List entries with no primary entry", action="store_true")
parser.add_argument('--leavefiles', help="Do not remove temporary files", action="store_true")
parser.add_argument('--verbose', help="Verbose for debugging this script", action="store_true")
parser.add_argument('--constfiles', help="Create files containing sorted lists of info and string constants", action="store_true")
parser.add_argument('--constfile', help="Read constant entries from this file and add to constlist. This prevents these names from appearing in warning messages when generating the constfiles (using --constfiles)", type=str)
parser.add_argument('--printnolist', help="Add warning for any const not in a const list", action="store_true")
parser.add_argument('--noremovedup', help="Do not remove non-primary entries on the same page as a primary entry", action="store_true")
#parser.add_argument('--newexamples', help="Add new example index entries", action="store_true")
parser.add_argument('--noexampleindex', help="Turn off different entries for examples in the indices", nargs='+', choices=('number', 'bydesc', 'withdesc', 'mpifunction', 'const', 'decl', 'typedefs'))
parser.add_argument('--lognomain', help="Write entries with no primary entry to the specified file", type=str)
parser.add_argument('--idxfile', help="Input index file", type=str)
parser.add_argument('--warnfile', help="Use this file for warning messages", type=str)
parser.add_argument('--warndupmain', help="Warn about duplicate primary (main) index entries", action="store_true")

args = parser.parse_args()
# Convert determined arg values into internal variable values
if args.idxfile :
    idxfname = args.idxfile
if args.nomain :
    ignoreNoPrimary = 0
    printNoPrimary  = 1
if args.leavefiles :
    cleanupFiles = 0
if args.verbose :
    verbose = 1
if args.constfiles :
    createConstListFiles = 1
if args.printnolist :
    printNotInConstlist = 1
if args.noremovedup :
    removeDupSecondaryEntries = 0
if args.warndupmain :
    warnDupPrimary = 1
if args.lognomain:
    noprimefile     = open(args.lognomain, "w")
    logNoPrimary    = 1
    if ignoreNoPrimary:
        printNoPrimary = 0
    ignoreNoPrimary = 0
if args.constfile :
    addFileToConstList(args.constfile)
if args.noexampleindex :
    for name in args.noexampleindex :
        name = name.upper()
        ExamplesToAdd[name] = 0

if args.warnfile:
    warningfile = open(args.warnfile, "w")

# --------------------------------------------------------------------------
for idxname in idxlist:
    idxlists[idxname] = list()


## Process the index file from the latex run
idxfile = open(idxfname)
for line in idxfile:
    # Handle the top level split - extract entry, type, page
    entryObj = re.match(r'\\indexentry\{(.*)\|(.*)\}\{([0-9]+)\}', line, 0)
    if entryObj :
        entryFullText = entryObj.group(1)
        entryLinkType = entryObj.group(2)
        entryPage     = entryObj.group(3)

        # Extract entry type from entry
        e2Obj = re.match(r'NEWEXAMPLES:(.*)', entryFullText, 0)
        if e2Obj :
            processExample(e2Obj.group(1), entryLinkType, entryPage)
        else :
            e2Obj = re.match(r'([A-Z=]*):(.*)', entryFullText, 0)
            if e2Obj :
                entryIdxname = e2Obj.group(1)
                entryText    = e2Obj.group(2)
                if verbose :
                    print( "Index " + entryIdxname + ", text " + entryText + ", page " + entryPage + ", linktype " + entryLinkType)

                # Special case for term: check entry
                if entryIdxname == "TERM" :
                    checkValidIndexEntry( entryText, entryPage )

                foundConstList = 0   # Set to 1 if this item is not const
                                     # or if it is added to a constlist
                                     # Used to identify stray consts
                # Special cases for CONST (not for any of the other
                # types that also map to CONST)
                if entryIdxname == "CONST" :
                    [entryIdxname, entryText, foundConstList ] = processConst(entryText)
                # Special case for BCFUNCTION
                if entryIdxname == "BCFUNCTION" :
                    entryText = processBCFunction(entryText)
                    foundConstList = 1    # not a const
                if entryIdxname == "TYPEDEF" :
                    # Special case: remove any arglist
                    entryText    = removeArgList(entryText)
                    foundConstList = 1    # not a const

                # Map the entryIdxname to one of the 6 indices
                if entryIdxname in idxnameall :
                    # Check for constlist name before mapping to other type
                    if createConstListFiles and entryIdxname in constlistnames :
                        addNameToConstList(entryIdxname, entryText)
                        foundConstList = 1    # Special const type
                    entryIdxname = idxnameall[entryIdxname]
                else :
                    printWarning("Unrecognized index name " + entryIdxname)
                    # skip processing this entry
                    continue

                if printNotInConstlist and entryIdxname == "CONST" and not foundConstList :
                    if not entryText in constNoList :
                        printWarning("Const not in list " + entryText + " on page " + entryPage)
                        constNoList[entryText] = entryPage
            else :
                # No name is function
                entryIdxname = "MPIFUNCTION"
                # Special case: remove any arglist
                entryText    = removeArgList(entryFullText)
                # Ensure it is formatted
                entryText    = processFunction(entryText)

            # At this point, we can add the entries to the appropriate
            # indices
            idxlists[entryIdxname].append(entryText + "|" + entryLinkType + "}{" + entryPage )
    else :
        printWarning("Malformed index entry " + line)

# Perform tests for primary entry and remove non-primary entries on the
# same page as a primary entry

# Output the lists and create the indices
mklog = open('mkindex.log', 'w')
for idxname in idxlist:
    # Need an option to not warn on no primary
    checkPrimary( idxlists[idxname], idxinfo[idxname]["label"], idxinfo[idxname]["qneedprimary"], idxinfo[idxname]["warndup"] )
    writeIndexData(idxlists[idxname], idxinfo[idxname]["file"])
    createIndex(idxinfo[idxname]["file"])
mklog.close()

# Create a single file with the indices
ofile = open( "func-index.tex", "w" )

tmpfiles = []
for idx in idxlist :
    writeHeader( ofile, idxinfo[idx]["title"], idxinfo[idx]["label"], idxinfo[idx]["header"] )
    iname = idxinfo[idx]["file"].replace('.idx', '.ind')
    appendFile( ofile, iname )
    tmpfiles.append(idxinfo[idx]["file"])
    tmpfiles.append(iname)
ofile.close()

if createConstListFiles :
    for lname in constlistnames :
        ofile = open( constlistnames[lname]["fname"], "w" )
        writeConstList( constLists[lname], constlistnames[lname]["cmd"], ofile)
        ofile.close()

if cleanupFiles:
    for file in tmpfiles :
        os.remove(file)

# Return non-zero error code if there were warnings
if warncount and warnFails :
    sys.exit(1)
