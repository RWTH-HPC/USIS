# Check for valid index entries, including subentries. The format of
# an index entry is
#    name@formatedname[!name@formattedname]*
# The approach is to split at any "!" and process each entry level.
# Any formatting is discarded.

# check a single index entry (no sublevels), Returns 0 on failure, 1 on
# success
def checkValidIndexText( str ) :
    # Remove any formatting
    nameclean = re.sub('@.*','', str)
    # TEMP: Allow \_
    nameclean = re.sub(r'\\_', '_', nameclean)

    # Are there any invalid characters?
    # Do NOT include a comma - this usually means that a subitem
    # was intended
    if re.search(r'[^a-zA-Z0-9_!:/\(\)\. *-]',nameclean) :
        # check for the exceptions
        if nameclean not in knownOKnew :
            printWarning( "Name contains invalid characters:" + nameclean)
            printWarning( "Full entry is: " + str )
            return 0
    return 1

# An entire, possibly multi-level entry
def checkValidIndexEntry( str, ePage ) :
    # Handle the case of an escaped !.
    newstr = str.replace('"!', "")
    entries = newstr.split("!")
    # Check for too many !
    if len(entries) > 3 :
        printWarning( "Name contains too many subitems: " + str + " on page " + ePage)
    for entry in entries :
        if not checkValidIndexText(entry) :
            printWarning("Index entry " + entry + " contains invalid characters")
            printWarning("Full entry is " + str + " on page " + ePage)

